# Enable development behavior for commands that import the app directly
FASTAPI_ENV=development

PROJECT_NAME="Tahona Inventario"

# Días de antelación para la alerta de caducidad de un lote (RF-023)
DIAS_AVISO_CADUCIDAD=5

SECRET_KEY=changethis
